pkgbase = tt
	pkgdesc = Command-line utility to manage Tarantool applications
	pkgver = 2.15.2
	pkgrel = 1
	url = https://github.com/tarantool/tt
	arch = x86_64
	license = BSD-2-Clause
	license = Apache-2.0
	license = BSD-3-Clause
	license = MIT
	license = MPL-2.0
	makedepends = go
	makedepends = mage
	depends = glibc
	depends = openssl-3
	depends = libcrypto.so
	depends = libssl.so
	optdepends = tarantool: to run Tarantool applications
	optdepends = git: for tt create and tt rocks
	optdepends = unzip: for tt rocks
	optdepends = zip: for tt pack
	optdepends = curl: for tt rocks
	optdepends = logrotate: to rotate the logs of the system environment
	options = !debug
	options = !lto
	backup = etc/tarantool/tt.yaml
	backup = etc/logrotate.d/tt
	source = https://github.com/tarantool/tt/releases/download/v2.15.2/tt-2.15.2-complete.tar.gz
